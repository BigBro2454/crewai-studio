# ─── App Settings ─────────────────────────────────────────────────────────────
APP_NAME="CrewAI Studio"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# ─── LLM Providers ────────────────────────────────────────────────────────────
# Default provider: openai | anthropic | google
DEFAULT_LLM_PROVIDER=google

# Google Gemini (Recommended)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Anthropic (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── Tools / Integrations (Optional) ──────────────────────────────────────────
SERPER_API_KEY=your_serper_api_key_here          # Google Search via Serper
BROWSERLESS_API_KEY=your_browserless_api_key_here  # Headless browser automation
